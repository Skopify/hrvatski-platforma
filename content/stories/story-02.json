  "part": 2,
  "title_hr": "Nina ide na tržnicu",
  "title_nl": "Nina gaat naar de markt",
  "cefr": "A1.2",
  "requires_lesson": 8,
  "blurb_nl": "Nina doet boodschappen op de Dolac. Elk ding dat ze koopt staat in de accusatief — precies wat les 5 tot en met 8 hebben opgebouwd.",
  "motif": "trznica",
  "focus_nl": [
    "accusatief",
    "ići + u/na",
    "jesti en piti",
    "imati / nemati"
  ],
  "source": "aangevuld",
  "paragraphs": [
    {
      "id": "p1",
      "sentences": [
        {
          "hr": "Subota je.",
          "nl": "Het is zaterdag."
        },
        {
          "hr": "Nina ide na tržnicu.",
          "nl": "Nina gaat naar de markt."
        },
        {
          "hr": "Tržnica se zove Dolac.",
          "nl": "De markt heet Dolac."
        },
        {
          "hr": "Ona treba mlijeko i kruh.",
          "nl": "Ze heeft melk en brood nodig."
        }
      ]
    },
    {
      "id": "p2",
      "sentences": [
        {
          "hr": "Nina kupuje kruh, sir i mlijeko.",
          "nl": "Nina koopt brood, kaas en melk."
        },
        {
          "hr": "Gleda rajčice.",
          "nl": "Ze bekijkt de tomaten."
        },
        {
          "hr": "Prodavačica pita: „Što želite, gospođo?“",
          "nl": "De marktvrouw vraagt: \"Wat wenst u, mevrouw?\""
        },
        {
          "hr": "„Želim jednu rajčicu i jednu jabuku, molim.“",
          "nl": "\"Ik wil één tomaat en één appel, graag.\""
        },
        {
          "hr": "„Izvolite!“",
          "nl": "\"Alstublieft!\""
        }
      ]
    },
    {
      "id": "p3",
      "sentences": [
        {
          "hr": "Nina vidi Petru.",
          "nl": "Nina ziet Petra."
        },
        {
          "hr": "Petra također kupuje voće.",
          "nl": "Petra koopt ook fruit."
        },
        {
          "hr": "„Bok, Nina! Idemo na kavu?“",
          "nl": "\"Hoi Nina! Zullen we koffie gaan drinken?\""
        },
        {
          "hr": "„Može! Ja častim.“",
          "nl": "\"Prima! Ik trakteer.\""
        }
      ]
    },
    {
      "id": "p4",
      "sentences": [
        {
          "hr": "One idu u kafić.",
          "nl": "Ze gaan naar een café."
        },
        {
          "hr": "Nina pije kavu, a Petra pije čaj.",
          "nl": "Nina drinkt koffie en Petra drinkt thee."
        },
        {
          "hr": "Jedu i kolač.",
          "nl": "Ze eten ook gebak."
        },
        {
          "hr": "Nina voli subotu.",
          "nl": "Nina houdt van zaterdag."
        }
      ]
    }
  ],
