  "comprehension": [
    {
      "id": "b.pr2.001",
      "skill": "hoofdgedachte",
      "type": "choice",
      "prompt_nl": "Waar gaat dit verhaal over?",
      "answer": "Een zaterdagochtend van Nina: boodschappen en daarna koffie.",
      "distractors": [
        "Hoe duur het leven in Zagreb is.",
        "Een ruzie tussen Nina en een marktvrouw.",
        "Nina die leert koken."
      ],
      "explain_nl": "De tekst volgt één ochtend van begin tot eind: markt, ontmoeting, café. Over prijzen of ruzie staat er niets. Een hoofdgedachte is vaak simpelweg: wie doet wat, wanneer.",
      "difficulty": 3
    },
    {
      "id": "b.pr2.002",
      "skill": "volgorde",
      "type": "choice",
      "prompt_nl": "In welke volgorde gebeurt het?",
      "answer": "Brood kopen → Petra zien → naar het café → koffie drinken",
      "distractors": [
        "Petra zien → brood kopen → koffie drinken → naar het café",
        "Naar het café → koffie drinken → brood kopen → Petra zien",
        "Brood kopen → naar het café → Petra zien → koffie drinken"
      ],
      "explain_nl": "Let op de signaalwoorden en de alinea-indeling: elke alinea is een volgende stap. De ontmoeting met Petra staat in alinea 3, ná het kopen in alinea 2 — dus het café kan pas daarna komen.",
      "difficulty": 3
    },
    {
      "id": "b.pr2.003",
      "skill": "woordbetekenis",
      "type": "choice",
      "prompt_nl": "«Može! Ja častim.» Wat betekent «Ja častim»?",
      "answer": "Ik trakteer.",
      "distractors": [
        "Ik heb haast.",
        "Ik lust geen koffie.",
        "Ik betaal later."
      ],
      "explain_nl": "Petra stelt koffie voor, Nina zegt «Može!» (prima) en dan dit. In die situatie is er maar één ding dat je erna zegt. Zo leid je de betekenis af uit wat er vlak vóór gebeurt.",
      "difficulty": 3
    },
    {
      "id": "b.pr2.004",
      "skill": "detail",
      "type": "choice",
      "prompt_nl": "Wat koopt Petra op de markt?",
      "answer": "Fruit.",
      "distractors": [
        "Brood en kaas.",
        "Melk.",
        "Een tomaat en een appel."
      ],
      "explain_nl": "Er staat «Petra također kupuje voće» — Petra koopt ook fruit. De andere antwoorden staan wél in de tekst, maar dat koopt Nina. Bij een detailvraag moet je niet alleen het ding terugvinden, maar ook wie het doet.",
      "difficulty": 4
    },
    {
      "id": "b.pr2.005",
      "skill": "afleiden",
      "type": "choice",
      "prompt_nl": "Waaraan merk je dat Nina en Petra elkaar goed kennen?",
      "answer": "Petra stelt zomaar voor om samen koffie te gaan drinken.",
      "distractors": [
        "Ze wonen in hetzelfde huis.",
        "Ze kopen precies dezelfde boodschappen.",
        "Petra spreekt Nederlands tegen Nina."
      ],
      "explain_nl": "Dat ze bevriend zijn staat er niet. Maar Petra groet met «Bok» (informeel), stelt meteen iets voor, en Nina biedt aan te trakteren. Die manier van doen hoort bij mensen die elkaar kennen — gedrag verraadt hier de relatie.",
      "difficulty": 4
    }
  ],
