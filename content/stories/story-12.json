{
  "id": "story-12",
  "slug": "sto-zelite",
  "series": "Kavana Zvono",
  "part": 2,
  "title_hr": "Što želite?",
  "title_nl": "Wat wilt u?",
  "cefr": "A1.2",
  "requires_lesson": 9,
  "motif": "kavana",
  "blurb_nl": "Een volle zaterdag achter de bar. Alles wat besteld wordt staat in de accusatief — en een kind stelt de vraag waar Vinko geen antwoord op geeft.",
  "focus_nl": [
    "accusatief",
    "tegenwoordige tijd",
    "želim en naručujem",
    "vraagwoorden"
  ],
  "source": "verhaal-12",
  "paragraphs": [
    {
      "id": "p1",
      "sentences": [
        {
          "id": "sto-zelite.p1.s1",
          "hr": "Subota je i kavana je puna.",
          "nl": "Het is zaterdag en het café zit vol."
        },
        {
          "id": "sto-zelite.p1.s2",
          "hr": "Sanja radi za šankom, a ja nosim kave.",
          "nl": "Sanja staat achter de bar, en ik breng de koffie rond."
        },
        {
          "id": "sto-zelite.p1.s3",
          "hr": "Vinko sjedi kod prozora i čita novine.",
          "nl": "Vinko zit bij het raam en leest de krant."
        }
      ]
    },
    {
      "id": "p2",
      "sentences": [
        {
          "id": "sto-zelite.p2.s1",
          "hr": "Prvi gost želi bijelu kavu.",
          "nl": "De eerste gast wil koffie met melk."
        },
        {
          "id": "sto-zelite.p2.s2",
          "hr": "Drugi želi čaj i kolač.",
          "nl": "De tweede wil thee en gebak."
        },
        {
          "id": "sto-zelite.p2.s3",
          "hr": "Treći ne želi ništa, samo vodu.",
          "nl": "De derde wil niets, alleen water."
        },
        {
          "id": "sto-zelite.p2.s4",
          "hr": "«Što želite?» pitam cijeli dan.",
          "nl": "«Wat wilt u?» vraag ik de hele dag."
        }
      ]
    },
    {
      "id": "p3",
      "sentences": [
        {
          "id": "sto-zelite.p3.s1",
          "hr": "Jedna žena naručuje sok za kćerku.",
          "nl": "Een vrouw bestelt sap voor haar dochter."
        },
        {
          "id": "sto-zelite.p3.s2",
          "hr": "Dijete gleda zvono na zidu.",
          "nl": "Het kind kijkt naar de bel aan de muur."
        },
        {
          "id": "sto-zelite.p3.s3",
          "hr": "«Zašto je tu zvono?» pita me.",
          "nl": "«Waarom hangt daar een bel?» vraagt ze me."
        },
        {
          "id": "sto-zelite.p3.s4",
          "hr": "Ne znam odgovor.",
          "nl": "Ik weet het antwoord niet."
        }
      ]
    },
    {
      "id": "p4",
      "sentences": [
        {
          "id": "sto-zelite.p4.s1",
          "hr": "Pitam Vinka.",
          "nl": "Ik vraag het aan Vinko."
        },
        {
          "id": "sto-zelite.p4.s2",
          "hr": "On gleda zvono i ne kaže ništa.",
          "nl": "Hij kijkt naar de bel en zegt niets."
        },
        {
          "id": "sto-zelite.p4.s3",
          "hr": "Onda pije kavu i čita dalje.",
          "nl": "Dan drinkt hij zijn koffie en leest verder."
        },
        {
          "id": "sto-zelite.p4.s4",
          "hr": "Sanja se smije. «Nikad ne odgovara», kaže.",
          "nl": "Sanja lacht. «Hij antwoordt nooit», zegt ze."
        }
      ]
    }
  ],
