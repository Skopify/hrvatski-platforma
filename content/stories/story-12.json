  "comprehension": [
    {
      "id": "b.pr12.001",
      "skill": "hoofdgedachte",
      "type": "choice",
      "prompt_nl": "Waar gaat deze tekst vooral over?",
      "answer": "Een drukke dienst, en een vraag over de bel die onbeantwoord blijft.",
      "distractors": [
        "Hoe je in een Kroatisch café koffie bestelt.",
        "Waarom Lea het werk te zwaar vindt.",
        "Een ruzie tussen Vinko en een gast."
      ],
      "explain_nl": "De bestellingen vullen de eerste helft, maar de tekst draait naar de vraag van het kind — en eindigt op het uitblijven van een antwoord.",
      "difficulty": 3
    },
    {
      "id": "b.pr12.002",
      "skill": "detail",
      "type": "choice",
      "prompt_nl": "Wat wil de derde gast?",
      "answer": "Alleen water.",
      "distractors": [
        "Thee en gebak.",
        "Koffie met melk.",
        "Sap voor zijn dochter."
      ],
      "explain_nl": "«Treći ne želi ništa, samo vodu.» De ontkenning en «samo» horen bij elkaar.",
      "difficulty": 1
    },
    {
      "id": "b.pr12.003",
      "skill": "verwijswoord",
      "type": "choice",
      "prompt_nl": "«Pita me.» — wie is «me»?",
      "answer": "Lea, de verteller.",
      "distractors": [
        "Vinko.",
        "De moeder van het kind.",
        "Sanja."
      ],
      "explain_nl": "De tekst is in de ik-vorm. «Me» is de korte accusatiefvorm van ja.",
      "difficulty": 2
    },
    {
      "id": "b.pr12.004",
      "skill": "afleiden",
      "type": "choice",
      "prompt_nl": "Waarom weet Lea het antwoord over de bel niet?",
      "answer": "Ze werkt er pas kort en niemand heeft het haar verteld.",
      "distractors": [
        "Ze heeft de vraag niet goed verstaan.",
        "Vinko heeft het haar verboden te zeggen.",
        "De bel hangt er pas net."
      ],
      "explain_nl": "Uit deel 1 weet je dat dit haar eerste baan is en dat ze alleen in het weekend werkt. Het verhaal zegt het niet met zoveel woorden.",
      "difficulty": 4
    },
    {
      "id": "b.pr12.005",
      "skill": "conclusie",
      "type": "choice",
      "prompt_nl": "Sanja zegt: «Nikad ne odgovara.» Wat volgt daaruit?",
      "answer": "Anderen hebben het ook al gevraagd, en kregen ook geen antwoord.",
      "distractors": [
        "Vinko is doof aan één oor.",
        "Sanja weet het antwoord wel.",
        "De bel is niet belangrijk."
      ],
      "explain_nl": "«Nikad» maakt er een patroon van. Dat de vraag vaker gesteld is, maakt het zwijgen opzettelijk.",
      "difficulty": 4
    },
    {
      "id": "b.pr12.006",
      "skill": "woordbetekenis",
      "type": "choice",
      "prompt_nl": "«Onda pije kavu i čita dalje.» Wat betekent «dalje»?",
      "answer": "verder",
      "distractors": [
        "hardop",
        "langzaam",
        "opnieuw"
      ],
      "explain_nl": "Hij was al aan het lezen en gaat daarmee door. «Dalje» hoort bij het werkwoord, niet bij de koffie.",
      "difficulty": 3
    }
  ],
  "exercises": [
    {
      "id": "e.pr12.001",
      "type": "cloze",
      "mode": "productive",
      "prompt_nl": "Vul aan: «De eerste gast wil koffie met melk.»",
      "given": "Prvi gost želi bijelu ___.",
      "answer": "kavu",
      "accepts": [
        "kavu"
      ],
      "explain_nl": "Kava is het lijdend voorwerp van željeti, dus accusatief: kava → kavu. Het bijvoeglijk naamwoord gaat mee: bijela → bijelu.",
      "targets": [
        "g.08.akuzativ.objekt"
      ],
      "difficulty": 2,
      "audio": "Prvi gost želi bijelu kavu.",
      "source": "verhaal-12"
    },
    {
      "id": "e.pr12.002",
      "type": "interpret",
      "mode": "receptive",
      "prompt_nl": "Welke zin zegt dat de gast er nu een bestelt?",
      "given": "A: Treći ne želi ništa.\nB: Treći želi vodu.",
      "answer": "B — želi zonder ne is een wens die wordt uitgesproken.",
      "distractors": [
        "A — ništa betekent dat hij nog kiest.",
        "Allebei.",
        "Geen van beide."
      ],
      "explain_nl": "«Ne želi ništa» is een dubbele ontkenning: in het Kroatisch hoort die er, en samen betekenen ze één keer nee.",
      "targets": [
        "g.mod.neg_verb"
      ],
      "difficulty": 3,
      "source": "verhaal-12"
    },
    {
      "id": "e.pr12.003",
      "type": "choice",
      "mode": "receptive",
      "prompt_nl": "Waarom «Pitam Vinka» en niet «Pitam Vinko»?",
