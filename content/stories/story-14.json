{
  "id": "story-14",
  "slug": "racun",
  "series": "Kavana Zvono",
  "part": 4,
  "title_hr": "Račun",
  "title_nl": "De rekening",
  "cefr": "A2.2",
  "requires_lesson": 17,
  "motif": "kavana",
  "blurb_nl": "Lea rekent een groep te weinig aan en wil het uit eigen zak betalen. Getallen, geld en de datief — en een baas die anders reageert dan ze verwacht.",
  "focus_nl": [
    "getallen",
    "genitief na telwoorden",
    "datief",
    "modale werkwoorden"
  ],
  "source": "verhaal-14",
  "paragraphs": [
    {
      "id": "p1",
      "sentences": [
        {
          "id": "racun.p1.s1",
          "hr": "U subotu sam pogriješila.",
          "nl": "Zaterdag heb ik een fout gemaakt."
        },
        {
          "id": "racun.p1.s2",
          "hr": "Jedna grupa je naručila šest kava, tri soka i četiri kolača.",
          "nl": "Een groep bestelde zes koffie, drie sap en vier gebakjes."
        },
        {
          "id": "racun.p1.s3",
          "hr": "Napisala sam račun i dala im ga.",
          "nl": "Ik schreef de rekening en gaf hem aan ze."
        },
        {
          "id": "racun.p1.s4",
          "hr": "Platili su i otišli.",
          "nl": "Ze betaalden en gingen weg."
        }
      ]
    },
    {
      "id": "p2",
      "sentences": [
        {
          "id": "racun.p2.s1",
          "hr": "Poslije sam vidjela da nešto nije u redu.",
          "nl": "Later zag ik dat er iets niet klopte."
        },
        {
          "id": "racun.p2.s2",
          "hr": "Na računu su bile samo tri kave.",
          "nl": "Op de rekening stonden maar drie koffies."
        },
        {
          "id": "racun.p2.s3",
          "hr": "Gledala sam račun još jednom, i onda još jednom.",
          "nl": "Ik keek nog een keer naar de rekening, en toen nog een keer."
        },
        {
          "id": "racun.p2.s4",
          "hr": "Nedostajalo je devet eura.",
          "nl": "Er ontbrak negen euro."
        },
        {
          "id": "racun.p2.s5",
          "hr": "Devet eura nije puno, ali nije ni malo.",
          "nl": "Negen euro is niet veel, maar ook niet weinig."
        }
      ]
    },
    {
      "id": "p3",
      "sentences": [
        {
          "id": "racun.p3.s1",
          "hr": "Htjela sam to platiti iz svoje plaće.",
          "nl": "Ik wilde het uit mijn eigen loon betalen."
        },
        {
          "id": "racun.p3.s2",
          "hr": "Stajala sam pokraj šanka s novcem u ruci.",
          "nl": "Ik stond bij de bar met het geld in mijn hand."
        },
        {
          "id": "racun.p3.s3",
          "hr": "Nisam znala kako mu to reći.",
          "nl": "Ik wist niet hoe ik het hem moest zeggen."
        },
        {
          "id": "racun.p3.s4",
          "hr": "Vinko me dugo gledao.",
          "nl": "Vinko keek me lang aan."
        },
        {
          "id": "racun.p3.s5",
          "hr": "«Koliko imaš godina?» pitao je.",
          "nl": "«Hoe oud ben je?» vroeg hij."
        },
        {
          "id": "racun.p3.s6",
          "hr": "«Dvadeset dvije.»",
          "nl": "«Tweeëntwintig.»"
        },
        {
          "id": "racun.p3.s7",
          "hr": "«Onda ćeš još puno griješiti.»",
          "nl": "«Dan ga je nog veel fouten maken.»"
        }
      ]
    },
    {
      "id": "p4",
      "sentences": [
        {
          "id": "racun.p4.s1",
          "hr": "Nije uzeo novac.",
          "nl": "Hij nam het geld niet aan."
        },
        {
          "id": "racun.p4.s2",
          "hr": "Rekao mi je da moram brojati naglas.",
          "nl": "Hij zei me dat ik hardop moet tellen."
        },
        {
          "id": "racun.p4.s3",
          "hr": "«Šest kava», rekao je. «Reci to glasno i onda napiši.»",
          "nl": "«Zes koffie», zei hij. «Zeg het hardop en schrijf het dan pas op.»"
        }
      ]
    },
    {
      "id": "p5",
      "sentences": [
        {
          "id": "racun.p5.s1",
          "hr": "Sada svaki račun čitam dva puta.",
          "nl": "Nu lees ik elke rekening twee keer."
        },
        {
          "id": "racun.p5.s2",
          "hr": "Sanja kaže da to radi već pet godina.",
          "nl": "Sanja zegt dat ze dat al vijf jaar doet."
        },
        {
          "id": "racun.p5.s3",
          "hr": "Vinko nikad više nije govorio o tome.",
          "nl": "Vinko heeft er nooit meer over gesproken."
        },
        {
          "id": "racun.p5.s4",
          "hr": "Gospodin Horvat je i dalje u bolnici.",
          "nl": "Meneer Horvat ligt nog steeds in het ziekenhuis."
        },
        {
          "id": "racun.p5.s5",
          "hr": "Njegov stol je i dalje prazan.",
          "nl": "Zijn tafel is nog steeds leeg."
        }
      ]
    }
  ],
