{
  "id": "story-13",
  "slug": "gospodin-s-novinama",
  "series": "Kavana Zvono",
  "part": 3,
  "title_hr": "Gospodin s novinama",
  "title_nl": "De meneer met de krant",
  "cefr": "A2.1",
  "requires_lesson": 13,
  "motif": "kavana",
  "blurb_nl": "Een vaste gast komt op een dag niet meer. Alles staat in de verleden tijd, en de locatief zegt telkens waar iemand is — of juist niet is.",
  "focus_nl": [
    "perfekt",
    "locatief",
    "deelwoorden",
    "duur en herhaling"
  ],
  "source": "verhaal-13",
  "paragraphs": [
    {
      "id": "p1",
      "sentences": [
        {
          "id": "gospodin-s-novinama.p1.s1",
          "hr": "Gospodin Horvat je dolazio svaki dan.",
          "nl": "Meneer Horvat kwam elke dag."
        },
        {
          "id": "gospodin-s-novinama.p1.s2",
          "hr": "Uvijek u deset sati, uvijek za istim stolom.",
          "nl": "Altijd om tien uur, altijd aan dezelfde tafel."
        },
        {
          "id": "gospodin-s-novinama.p1.s3",
          "hr": "Naručivao je jednu kavu i čitao novine.",
          "nl": "Hij bestelde één koffie en las de krant."
        },
        {
          "id": "gospodin-s-novinama.p1.s4",
          "hr": "Novine je čitao polako, stranicu po stranicu.",
          "nl": "De krant las hij langzaam, bladzijde voor bladzijde."
        },
        {
          "id": "gospodin-s-novinama.p1.s5",
          "hr": "Nikad nije govorio puno.",
          "nl": "Hij zei nooit veel."
        }
      ]
    },
    {
      "id": "p2",
      "sentences": [
        {
          "id": "gospodin-s-novinama.p2.s1",
          "hr": "Prošli tjedan nije došao.",
          "nl": "Vorige week kwam hij niet."
        },
        {
          "id": "gospodin-s-novinama.p2.s2",
          "hr": "U utorak također nije došao.",
          "nl": "Dinsdag kwam hij ook niet."
        },
        {
          "id": "gospodin-s-novinama.p2.s3",
          "hr": "Sanja je rekla da je možda bolestan.",
          "nl": "Sanja zei dat hij misschien ziek was."
        },
        {
          "id": "gospodin-s-novinama.p2.s4",
          "hr": "Vinko nije rekao ništa, ali je gledao prema vratima.",
          "nl": "Vinko zei niets, maar keek naar de deur."
        }
      ]
    },
    {
      "id": "p3",
      "sentences": [
        {
          "id": "gospodin-s-novinama.p3.s1",
          "hr": "U petak sam pitala Vinka gdje je gospodin Horvat.",
          "nl": "Vrijdag vroeg ik Vinko waar meneer Horvat was."
        },
        {
          "id": "gospodin-s-novinama.p3.s2",
          "hr": "«U bolnici», rekao je.",
          "nl": "«In het ziekenhuis», zei hij."
        },
        {
          "id": "gospodin-s-novinama.p3.s3",
          "hr": "«Kako znaš?» pitala sam.",
          "nl": "«Hoe weet je dat?» vroeg ik."
        },
        {
          "id": "gospodin-s-novinama.p3.s4",
          "hr": "«Zovem ga svaki dan.»",
          "nl": "«Ik bel hem elke dag.»"
        }
      ]
    },
    {
      "id": "p4",
      "sentences": [
        {
          "id": "gospodin-s-novinama.p4.s1",
          "hr": "Nisam znala da se poznaju tako dobro.",
          "nl": "Ik wist niet dat ze elkaar zo goed kenden."
        },
        {
          "id": "gospodin-s-novinama.p4.s2",
          "hr": "U kavani nikad nisu razgovarali.",
          "nl": "In het café praatten ze nooit."
        },
        {
          "id": "gospodin-s-novinama.p4.s3",
          "hr": "Vinko je onda rekao nešto čudno.",
          "nl": "Vinko zei toen iets vreemds."
        },
        {
          "id": "gospodin-s-novinama.p4.s4",
          "hr": "«Njegov stol je i dalje njegov.»",
          "nl": "«Zijn tafel is en blijft van hem.»"
        }
      ]
    },
    {
      "id": "p5",
      "sentences": [
        {
          "id": "gospodin-s-novinama.p5.s1",
          "hr": "Cijeli tjedan nitko nije sjedio za tim stolom.",
          "nl": "De hele week zat er niemand aan die tafel."
        },
        {
          "id": "gospodin-s-novinama.p5.s2",
          "hr": "Kad je bilo puno, Vinko je govorio da je zauzet.",
          "nl": "Als het vol was, zei Vinko dat hij bezet was."
        },
        {
          "id": "gospodin-s-novinama.p5.s3",
          "hr": "U subotu je jedna žena htjela sjesti tamo.",
          "nl": "Zaterdag wilde een vrouw daar gaan zitten."
        },
        {
          "id": "gospodin-s-novinama.p5.s4",
          "hr": "Vinko joj je dao drugi stol, uz prozor.",
          "nl": "Vinko gaf haar een andere tafel, bij het raam."
        },
        {
          "id": "gospodin-s-novinama.p5.s5",
          "hr": "Nitko nije pitao zašto.",
          "nl": "Niemand vroeg waarom."
        }
      ]
    }
  ],
