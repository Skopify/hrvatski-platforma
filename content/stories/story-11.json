  "blurb_nl": "Lea begint te werken in een klein café in Zagreb. Alles staat in de nominatief: wie iemand is, hoe iets heet, wat waar staat.",
  "focus_nl": [
    "nominatief",
    "biti",
    "zvati se",
    "bijvoeglijke naamwoorden"
  ],
  "source": "verhaal-11",
  "paragraphs": [
    {
      "id": "p1",
      "sentences": [
        {
          "id": "kavana-zvono.p1.s1",
          "hr": "Ovo je kavana Zvono.",
          "nl": "Dit is café Zvono."
        },
        {
          "id": "kavana-zvono.p1.s2",
          "hr": "Kavana je u Zagrebu.",
          "nl": "Het café is in Zagreb."
        },
        {
          "id": "kavana-zvono.p1.s3",
          "hr": "Nije velika, ali je lijepa.",
          "nl": "Het is niet groot, maar het is mooi."
        },
        {
          "id": "kavana-zvono.p1.s4",
          "hr": "Na zidu je staro zvono.",
          "nl": "Aan de muur hangt een oude bel."
        }
      ]
    },
    {
      "id": "p2",
      "sentences": [
        {
          "id": "kavana-zvono.p2.s1",
          "hr": "Ja sam Lea.",
          "nl": "Ik ben Lea."
        },
        {
          "id": "kavana-zvono.p2.s2",
          "hr": "Ja sam studentica.",
          "nl": "Ik ben studente."
        },
        {
          "id": "kavana-zvono.p2.s3",
          "hr": "Ovo je moj prvi posao.",
          "nl": "Dit is mijn eerste baan."
        },
        {
          "id": "kavana-zvono.p2.s4",
          "hr": "Radim ovdje subotom i nedjeljom.",
          "nl": "Ik werk hier op zaterdag en zondag."
        }
      ]
    },
    {
      "id": "p3",
      "sentences": [
        {
          "id": "kavana-zvono.p3.s1",
          "hr": "Vlasnik se zove Vinko.",
          "nl": "De eigenaar heet Vinko."
        },
        {
          "id": "kavana-zvono.p3.s2",
          "hr": "On je star čovjek.",
          "nl": "Hij is een oude man."
        },
        {
          "id": "kavana-zvono.p3.s3",
          "hr": "Vinko je ovdje već dugo.",
          "nl": "Vinko is hier al lang."
        },
        {
          "id": "kavana-zvono.p3.s4",
          "hr": "Njegova kava je dobra.",
          "nl": "Zijn koffie is goed."
        }
      ]
    },
    {
      "id": "p4",
      "sentences": [
        {
          "id": "kavana-zvono.p4.s1",
          "hr": "Moja kolegica se zove Sanja.",
          "nl": "Mijn collega heet Sanja."
        },
        {
          "id": "kavana-zvono.p4.s2",
          "hr": "Ona je brza i uvijek vesela.",
          "nl": "Zij is snel en altijd vrolijk."
        },
        {
          "id": "kavana-zvono.p4.s3",
          "hr": "Gosti su uvijek isti ljudi.",
          "nl": "De gasten zijn altijd dezelfde mensen."
        },
        {
          "id": "kavana-zvono.p4.s4",
          "hr": "Vinko kaže da je to dobro.",
          "nl": "Vinko zegt dat dat goed is."
        }
      ]
    }
  ],
