  "comprehension": [
    {
      "id": "b.pr11.001",
      "skill": "hoofdgedachte",
      "type": "choice",
      "prompt_nl": "Waar gaat deze tekst vooral over?",
      "answer": "Lea stelt het café voor waar ze werkt, en de mensen die er zijn.",
      "distractors": [
        "Hoe je in Zagreb een baan vindt.",
        "Waarom Vinko de kavana wil verkopen.",
        "Het verschil tussen een kavana en een restaurant."
      ],
      "explain_nl": "Elke alinea introduceert iets: eerst de zaak, dan Lea, dan Vinko, dan Sanja en de gasten. Er gebeurt nog niets — dit is de opstelling.",
      "difficulty": 2
    },
    {
      "id": "b.pr11.002",
      "skill": "detail",
      "type": "choice",
      "prompt_nl": "Wat hangt er aan de muur?",
      "answer": "Een oude bel.",
      "distractors": [
        "Een schilderij van Zagreb.",
        "Een klok.",
        "Een foto van Vinko."
      ],
      "explain_nl": "«Na zidu je staro zvono.» Zvono is de bel waar de zaak naar heet — daarom staat het er.",
      "difficulty": 1
    },
    {
      "id": "b.pr11.003",
      "skill": "verwijswoord",
      "type": "choice",
      "prompt_nl": "«On je star čovjek.» — naar wie verwijst «on»?",
      "answer": "Vinko.",
      "distractors": [
        "De gast.",
        "Lea's vader.",
        "Het café."
      ],
      "explain_nl": "De zin ervóór noemt Vinko. «On» is mannelijk enkelvoud en pakt de laatstgenoemde man op.",
      "difficulty": 2
    },
    {
      "id": "b.pr11.004",
      "skill": "afleiden",
      "type": "choice",
      "prompt_nl": "Werkt Lea elke dag in het café?",
      "answer": "Nee, alleen in het weekend.",
      "distractors": [
        "Ja, elke dag.",
        "Dat staat er niet.",
        "Alleen als Sanja er niet is."
      ],
      "explain_nl": "«Radim ovdje subotom i nedjeljom» — zaterdags en zondags. Dat past ook bij dat ze studente is.",
      "difficulty": 3
    },
    {
      "id": "b.pr11.005",
      "skill": "woordbetekenis",
      "type": "choice",
      "prompt_nl": "«Gosti su uvijek isti ljudi.» Wat betekent «isti» hier?",
      "answer": "dezelfde",
      "distractors": [
        "andere",
        "aardige",
        "veel"
      ],
      "explain_nl": "Het gaat om vaste gasten: elke keer dezelfde mensen. Dat is precies wat een kavana in de buurt is.",
      "difficulty": 3
    },
    {
      "id": "b.pr11.006",
      "skill": "conclusie",
      "type": "choice",
      "prompt_nl": "Vinko zegt dat het goed is dat de gasten altijd dezelfde zijn. Wat zegt dat over hem?",
      "answer": "Hij hecht aan vaste gasten, niet aan veel gasten.",
      "distractors": [
        "Hij wil niet te hard werken.",
        "Hij vindt nieuwe klanten lastig.",
        "Hij kent alleen die mensen nog."
      ],
      "explain_nl": "«To je dobro» is een oordeel, geen constatering. Voor Vinko is de kavana een plek voor bekenden — dat wordt in latere delen belangrijk.",
      "difficulty": 4
    }
  ],
  "exercises": [
    {
      "id": "e.pr11.001",
      "type": "choice",
      "mode": "receptive",
      "prompt_nl": "Waarom staat er «Nije velika» en niet «Nije velik»?",
      "answer": "Omdat kavana vrouwelijk is.",
      "distractors": [
        "Omdat het café klein is.",
        "Omdat er «nije» voor staat.",
        "Omdat velik altijd op -a eindigt."
