  "comprehension": [
    {
      "id": "b.pr1.001",
      "skill": "hoofdgedachte",
      "type": "choice",
      "prompt_nl": "Waar gaat deze tekst vooral over?",
      "answer": "Nina stelt zichzelf en de mensen om haar heen voor.",
      "distractors": [
        "Het leven van een zwarte kat in Zagreb.",
        "Waarom Kroatisch een moeilijke taal is.",
        "Een reis van Nederland naar Kroatië."
      ],
      "explain_nl": "Elke alinea introduceert iemand: Nina zelf, haar ouders, haar broer, haar vriendin. De kat is één zin en de reis komt helemaal niet voor. Bij een hoofdgedachtevraag kijk je wat álle alinea's gemeen hebben.",
      "difficulty": 3
    },
    {
      "id": "b.pr1.002",
      "skill": "verwijswoord",
      "type": "choice",
      "prompt_nl": "Van wie is de kat?",
      "given": "Moj brat se zove Tim. On je visok i mlad. Njegova mačka je crna i vrlo lijena.",
      "answer": "Van Tim.",
      "distractors": [
        "Van Nina.",
        "Van Petra.",
        "Van haar vader Jan."
      ],
      "explain_nl": "«Njegova» betekent 'zijn' — dus van een man. De laatst genoemde man is Tim. Let op de valstrik: «njegova» eindigt op -a omdat het zich richt naar mačka (vrouwelijk), niet omdat de eigenaar een vrouw is.",
      "difficulty": 4
    },
    {
      "id": "b.pr1.003",
      "skill": "detail",
      "type": "choice",
      "prompt_nl": "Wie in Nina's familie is Kroatisch?",
      "answer": "Haar moeder Ana.",
      "distractors": [
        "Haar vader Jan.",
        "Haar broer Tim.",
        "Haar vriendin Petra."
      ],
      "explain_nl": "Er staat letterlijk «Moja majka je Ana. (…) Ana je Hrvatica!» Petra is óók Kroatische, maar die is haar vriendin, geen familie — een klassieke afleider die wél in de tekst staat maar de vraag niet beantwoordt.",
      "difficulty": 3
    },
    {
      "id": "b.pr1.004",
      "skill": "afleiden",
      "type": "choice",
      "prompt_nl": "Waarom zegt Nina «Hrvatski je i moj jezik» — Kroatisch is óók mijn taal?",
      "answer": "Omdat haar moeder Kroatische is.",
      "distractors": [
        "Omdat ze in Kroatië geboren is.",
        "Omdat ze journaliste is.",
        "Omdat haar vriendin Petra het haar leert."
      ],
      "explain_nl": "De tekst legt het verband niet uit. Maar de zin komt direct na «Ana je Hrvatica!», en Ana is haar moeder. Uit die volgorde leid je de reden af — schrijvers zetten oorzaak en gevolg vaak naast elkaar zonder «daarom» te gebruiken.",
      "difficulty": 4
    },
    {
      "id": "b.pr1.005",
      "skill": "conclusie",
      "type": "choice",
      "prompt_nl": "Het verhaal eindigt met: «Zagreb je njezin grad. Sada je i moj.» Wat zegt Nina hiermee?",
      "answer": "Dat ze zich in Zagreb thuis begint te voelen.",
      "distractors": [
        "Dat ze een huis in Zagreb gekocht heeft.",
        "Dat Petra bij haar is ingetrokken.",
        "Dat ze Zagreb mooier vindt dan Petra."
      ],
      "explain_nl": "«Sada» (nu) zet iets tegenover vroeger, en «i moj» betekent 'ook de mijne'. Ze zegt niets over bezit — het gaat om ergens bij horen. Bij een conclusievraag ga je één stap verder dan de letterlijke woorden, maar niet verder dan de tekst toelaat.",
      "difficulty": 4
    }
  ],
