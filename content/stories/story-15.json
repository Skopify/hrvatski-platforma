  "comprehension": [
    {
      "id": "b.pr15.001",
      "skill": "hoofdgedachte",
      "type": "choice",
      "prompt_nl": "Waar gaat deze tekst vooral over?",
      "answer": "Een vraag die Vinko zijn vader nooit gesteld heeft, en wat dat met hem doet.",
      "distractors": [
        "De geschiedenis van een school in Zagreb.",
        "Waarom de bel kapot is.",
        "Hoe Lea eindelijk haar zin krijgt."
      ],
      "explain_nl": "De bel is de aanleiding. Waar het om draait staat in alinea 4: «Da sam znao što mu znači, pitao bih ga više» — spijt over een gesprek dat niet meer kan.",
      "difficulty": 4
    },
    {
      "id": "b.pr15.002",
      "skill": "detail",
      "type": "choice",
      "prompt_nl": "Waar komt de bel vandaan?",
      "answer": "Uit een school die vroeger in dezelfde straat stond.",
      "distractors": [
        "Uit een kerk in Zagreb.",
        "Uit het huis van Vinko's vader.",
        "Uit een andere kavana."
      ],
      "explain_nl": "«Zvono je došlo iz škole koja je bila u ovoj ulici prije rata.» De betrekkelijke bijzin met «koja» hangt de hele geschiedenis aan één woord.",
      "difficulty": 2
    },
    {
      "id": "b.pr15.003",
      "skill": "afleiden",
      "type": "choice",
      "prompt_nl": "Waarom waste Vinko twee kopjes die al schoon waren?",
      "answer": "Om iets te doen te hebben na een gesprek dat hem raakte.",
      "distractors": [
        "Omdat ze vies waren.",
        "Omdat er gasten kwamen.",
        "Omdat Lea dat vergeten was."
      ],
      "explain_nl": "Het staat er niet. Maar «koje su već bile čiste» is een detail dat alleen betekenis heeft als het niet om de kopjes gaat.",
      "difficulty": 5
    },
    {
      "id": "b.pr15.004",
      "skill": "verwijswoord",
      "type": "choice",
      "prompt_nl": "«Da sam znao što mu znači.» — naar wie verwijst «mu»?",
      "answer": "Vinko's vader.",
      "distractors": [
        "Vinko zelf.",
        "Meneer Horvat.",
        "De bel."
      ],
      "explain_nl": "De hele alinea gaat over de vader die hij nooit iets vroeg. «Mu» is datief mannelijk: wat het vóór hem betekende.",
      "difficulty": 4
    },
    {
      "id": "b.pr15.005",
      "skill": "verband",
      "type": "choice",
      "prompt_nl": "Waarom staat de terugkeer van meneer Horvat in dit verhaal?",
      "answer": "Als tegenhanger: hier komt iemand wél terug, en wordt er wél iets gezegd.",
      "distractors": [
        "Om te laten zien dat hij beter is.",
        "Omdat hij de bel ook kende.",
        "Om het verhaal langer te maken."
      ],
      "explain_nl": "Alinea 4 gaat over een gesprek dat nooit meer kan; alinea 6 laat een gesprek zien van drie woorden dat wél nog kan. Dat contrast draagt het slot.",
      "difficulty": 5
    },
    {
      "id": "b.pr15.006",
      "skill": "woordbetekenis",
      "type": "choice",
      "prompt_nl": "«Kao da nije bio nigdje.» Wat betekent dat hier?",
      "answer": "Alsof hij nooit weg was geweest.",
      "distractors": [
        "Alsof hij verdwaald was.",
        "Alsof hij niets meer wist.",
        "Alsof hij nergens welkom was."
      ],
      "explain_nl": "«Kao da» is «alsof». Hij ging zitten alsof er geen drie maanden tussen zaten — dat is hoe vaste gasten terugkomen.",
      "difficulty": 4
    },
    {
      "id": "b.pr15.007",
      "skill": "conclusie",
      "type": "choice",
      "prompt_nl": "Wat bedoelt Lea met de laatste zin?",
      "answer": "Dat de kavana een plek is waar op mensen gewacht wordt.",
      "distractors": [
        "Dat de deur vaak openstaat.",
        "Dat de bel ooit weer zal luiden.",
        "Dat ze zelf ook op iemand wacht."
      ],
      "explain_nl": "Ze verwerpt eerst de voor de hand liggende verklaring («ne zbog zvona») en geeft dan een andere. Het lege tafeltje uit deel 3 en het telefoontje naar het ziekenhuis wijzen dezelfde kant op.",
      "difficulty": 5
    },
    {
      "id": "b.pr15.008",
      "skill": "volgorde",
      "type": "choice",
      "prompt_nl": "In welke maand kwam meneer Horvat terug?",
      "answer": "Januari.",
      "distractors": [
        "December.",
        "Februari.",
        "Dat staat er niet."
      ],
      "explain_nl": "Het gesprek was «u prosincu» (december), de terugkeer «u siječnju» (januari). De Kroatische maandnamen lijken op niets — die moet je gewoon kennen.",
      "difficulty": 3
    }
  ],
  "exercises": [
    {
      "id": "e.pr15.001",
      "type": "choice",
      "mode": "receptive",
      "prompt_nl": "«…škole koja je bila u ovoj ulici.» Waarom «koja» en niet «koji»?",
      "answer": "Omdat het naar škola verwijst, en dat is vrouwelijk.",
      "distractors": [
        "Omdat de school er niet meer is.",
        "Omdat er «iz» voor staat.",
        "Omdat koja altijd na een komma komt."
      ],
      "explain_nl": "Het betrekkelijk voornaamwoord richt zich naar het woord waar het naar verwijst — niet naar de rol die het in de bijzin speelt.",
      "targets": [
        "g.mod.q_words"
      ],
      "difficulty": 4,
      "source": "verhaal-15"
    },
    {
      "id": "e.pr15.002",
      "type": "interpret",
      "mode": "receptive",
      "prompt_nl": "Welke zin gaat over iets dat níét gebeurd is?",
      "given": "A: Da sam znao, pitao bih ga više.\nB: Kad sam znao, pitao sam ga više.",
      "answer": "A — «da» plus de bih-vorm is een voorwaarde die niet vervuld is.",
      "distractors": [
        "B — de verleden tijd zegt dat het voorbij is.",
        "Allebei.",
        "Geen van beide."
      ],
      "explain_nl": "De conditionalis met bih beschrijft wat er gebeurd zou zijn. Vinko heeft het niet geweten en heeft dus niet gevraagd — dat is precies waar de alinea over gaat.",
      "targets": [
        "g.mod.conditional"
      ],
      "difficulty": 5,
      "source": "verhaal-15"
    },
    {
      "id": "e.pr15.003",
      "type": "cloze",
      "mode": "productive",
      "prompt_nl": "Vul de betrekkelijke vorm in: «twee kopjes die al schoon waren»",
      "given": "dvije šalice ___ su već bile čiste",
      "answer": "koje",
      "accepts": [
