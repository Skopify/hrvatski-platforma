{
  "id": "story-15",
  "slug": "zvono",
  "series": "Kavana Zvono",
  "part": 5,
  "title_hr": "Zvono",
  "title_nl": "De bel",
  "cefr": "B1",
  "requires_lesson": 19,
  "motif": "kavana",
  "blurb_nl": "Waarom hangt er een bel aan de muur? Vinko geeft eindelijk antwoord, en het antwoord gaat over zijn vader. Betrekkelijke bijzinnen en de voorwaardelijke wijs — en de vraag die te laat kwam.",
  "focus_nl": [
    "betrekkelijke bijzinnen",
    "conditionalis",
    "perfekt",
    "aspect"
  ],
  "source": "verhaal-15",
  "paragraphs": [
    {
      "id": "p1",
      "sentences": [
        {
          "id": "zvono.p1.s1",
          "hr": "Zvono na zidu ne zvoni.",
          "nl": "De bel aan de muur luidt niet."
        },
        {
          "id": "zvono.p1.s2",
          "hr": "Nitko ga nikad nije čuo, ni Sanja, koja tu radi pet godina.",
          "nl": "Niemand heeft hem ooit gehoord, ook Sanja niet, die er vijf jaar werkt."
        },
        {
          "id": "zvono.p1.s3",
          "hr": "Pitala sam Vinka tri puta.",
          "nl": "Ik heb het Vinko drie keer gevraagd."
        },
        {
          "id": "zvono.p1.s4",
          "hr": "Tri puta nije odgovorio.",
          "nl": "Drie keer gaf hij geen antwoord."
        }
      ]
    },
    {
      "id": "p2",
      "sentences": [
        {
          "id": "zvono.p2.s1",
          "hr": "U prosincu, kad je kavana bila prazna, pitala sam ga četvrti put.",
          "nl": "In december, toen het café leeg was, vroeg ik het hem voor de vierde keer."
        },
        {
          "id": "zvono.p2.s2",
          "hr": "Ovaj put je rekao: «Sjedni.»",
          "nl": "Deze keer zei hij: «Ga zitten.»"
        },
        {
          "id": "zvono.p2.s3",
          "hr": "Sjeo je nasuprot meni i dugo šutio.",
          "nl": "Hij ging tegenover me zitten en zweeg lang."
        },
        {
          "id": "zvono.p2.s4",
          "hr": "Vani je padao snijeg.",
          "nl": "Buiten viel er sneeuw."
        }
      ]
    },
    {
      "id": "p3",
      "sentences": [
        {
          "id": "zvono.p3.s1",
          "hr": "Kavanu je otvorio njegov otac, davne 1954. godine.",
          "nl": "Zijn vader opende het café, lang geleden in 1954."
        },
        {
          "id": "zvono.p3.s2",
          "hr": "Zvono je došlo iz škole koja je bila u ovoj ulici prije rata.",
          "nl": "De bel kwam uit de school die vóór de oorlog in deze straat stond."
        },
        {
          "id": "zvono.p3.s3",
          "hr": "Te škole više nema.",
          "nl": "Die school bestaat niet meer."
        },
        {
          "id": "zvono.p3.s4",
          "hr": "«Otac je uzeo zvono jer ga nitko drugi nije htio», rekao je Vinko.",
          "nl": "«Mijn vader nam de bel mee omdat niemand anders hem wilde», zei Vinko."
        },
        {
          "id": "zvono.p3.s5",
          "hr": "Nosila su ga dva čovjeka, cijelim putem do kavane.",
          "nl": "Twee mannen droegen hem, de hele weg tot aan het café."
        },
        {
          "id": "zvono.p3.s6",
          "hr": "Zvono je na tom zidu od prvog dana.",
          "nl": "De bel hangt sinds de eerste dag aan die muur."
        }
      ]
    },
    {
      "id": "p4",
      "sentences": [
        {
          "id": "zvono.p4.s1",
          "hr": "«Kad sam bio dijete, mislio sam da je to samo staro željezo.»",
          "nl": "«Toen ik een kind was, dacht ik dat het gewoon oud ijzer was.»"
        },
        {
          "id": "zvono.p4.s2",
          "hr": "«Nikad ga nisam pitao odakle je točno.»",
          "nl": "«Ik heb hem nooit gevraagd waar hij precies vandaan kwam.»"
        },
        {
          "id": "zvono.p4.s3",
          "hr": "«Pitao sam ga o svemu drugome», rekao je. «O ratu nikad.»",
          "nl": "«Ik heb hem naar alles gevraagd», zei hij. «Naar de oorlog nooit.»"
        },
        {
          "id": "zvono.p4.s4",
          "hr": "«Da sam znao što mu znači, pitao bih ga više.»",
          "nl": "«Als ik had geweten wat het voor hem betekende, had ik hem meer gevraagd.»"
        },
        {
          "id": "zvono.p4.s5",
          "hr": "«Sada nemam koga pitati.»",
          "nl": "«Nu heb ik niemand meer om het aan te vragen.»"
        }
      ]
    },
    {
      "id": "p5",
      "sentences": [
        {
          "id": "zvono.p5.s1",
          "hr": "Poslije toga smo šutjeli još deset minuta.",
          "nl": "Daarna zwegen we nog tien minuten."
        },
        {
          "id": "zvono.p5.s2",
          "hr": "Onda je ustao i oprao dvije šalice koje su već bile čiste.",
          "nl": "Toen stond hij op en waste twee kopjes die al schoon waren."
        },
        {
          "id": "zvono.p5.s3",
          "hr": "Nisam ga pitala je li dobro.",
          "nl": "Ik heb hem niet gevraagd of het ging."
        }
      ]
    },
    {
      "id": "p6",
      "sentences": [
        {
          "id": "zvono.p6.s1",
          "hr": "Gospodin Horvat se vratio u siječnju.",
          "nl": "Meneer Horvat kwam in januari terug."
        },
        {
          "id": "zvono.p6.s2",
          "hr": "Sjeo je za svoj stol, kao da nije bio nigdje.",
          "nl": "Hij ging aan zijn eigen tafel zitten, alsof hij nergens geweest was."
        },
        {
          "id": "zvono.p6.s3",
          "hr": "Vinko mu je donio kavu bez riječi.",
          "nl": "Vinko bracht hem koffie zonder een woord."
        },
        {
          "id": "zvono.p6.s4",
          "hr": "Sjedio je s novinama koje je već pročitao.",
          "nl": "Hij zat met een krant die hij al gelezen had."
        },
        {
          "id": "zvono.p6.s5",
          "hr": "Gospodin Horvat je rekao: «Hvala, Vinko.»",
          "nl": "Meneer Horvat zei: «Dank je, Vinko.»"
        },
        {
          "id": "zvono.p6.s6",
          "hr": "To je bila najduža rečenica koju sam ih čula reći jedan drugome.",
          "nl": "Dat was de langste zin die ik ze ooit tegen elkaar heb horen zeggen."
        }
      ]
    },
    {
      "id": "p7",
      "sentences": [
        {
          "id": "zvono.p7.s1",
          "hr": "Sada znam zašto se kavana zove Zvono.",
          "nl": "Nu weet ik waarom het café Zvono heet."
        },
        {
          "id": "zvono.p7.s2",
          "hr": "Ne zbog zvona koje ne zvoni.",
          "nl": "Niet vanwege de bel die niet luidt."
        },
        {
          "id": "zvono.p7.s3",
          "hr": "Nego zbog toga što netko ovdje uvijek čeka da se vrata otvore.",
          "nl": "Maar omdat hier altijd iemand wacht tot de deur opengaat."
        },
        {
          "id": "zvono.p7.s4",
          "hr": "To Vinku nisam rekla.",
          "nl": "Dat heb ik Vinko niet gezegd."
        }
      ]
    }
  ],
