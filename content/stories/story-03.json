  "part": 3,
  "title_hr": "Vikend u Samoboru",
  "title_nl": "Een weekend in Samobor",
  "cefr": "A2.1",
  "requires_lesson": 11,
  "blurb_nl": "Nina vertelt over gisteren: een uitstapje naar Samobor. Het hele verhaal staat in de perfekt — de verleden tijd die les 11 introduceert — plus de locatief uit les 10.",
  "motif": "izlet",
  "focus_nl": [
    "perfekt",
    "locatief",
    "biti + deelwoord",
    "u/na + locatief"
  ],
  "source": "aangevuld",
  "paragraphs": [
    {
      "id": "p1",
      "sentences": [
        {
          "id": "vikend-u-samoboru.p1.s1",
          "hr": "Jučer sam bila u Samoboru.",
          "nl": "Gisteren was ik in Samobor."
        },
        {
          "id": "vikend-u-samoboru.p1.s2",
          "hr": "Samobor je mali grad blizu Zagreba.",
          "nl": "Samobor is een stadje bij Zagreb."
        },
        {
          "id": "vikend-u-samoboru.p1.s3",
          "hr": "Petra i ja smo putovale autobusom.",
          "nl": "Petra en ik reisden met de bus."
        },
        {
          "id": "vikend-u-samoboru.p1.s4",
          "hr": "Vožnja je bila kratka.",
          "nl": "De rit was kort."
        }
      ]
    },
    {
      "id": "p2",
      "sentences": [
        {
          "id": "vikend-u-samoboru.p2.s1",
          "hr": "U Samoboru smo šetale po starom gradu.",
          "nl": "In Samobor wandelden we door het oude stadje."
        },
        {
          "id": "vikend-u-samoboru.p2.s2",
          "hr": "Na trgu smo vidjele malu crkvu i stare kuće.",
          "nl": "Op het plein zagen we een kerkje en oude huizen."
        },
        {
          "id": "vikend-u-samoboru.p2.s3",
          "hr": "Sunce je sjalo cijeli dan.",
          "nl": "De zon scheen de hele dag."
        }
      ]
    },
    {
      "id": "p3",
      "sentences": [
        {
          "id": "vikend-u-samoboru.p3.s1",
          "hr": "U kafiću smo naručile kremšnite.",
          "nl": "In het café bestelden we kremšnita's."
        },
        {
          "id": "vikend-u-samoboru.p3.s2",
          "hr": "Kremšnita je slavni kolač iz Samobora.",
          "nl": "De kremšnita is het beroemde gebak uit Samobor."
        },
        {
          "id": "vikend-u-samoboru.p3.s3",
          "hr": "Petra je pojela dvije!",
          "nl": "Petra at er twee op!"
        },
        {
          "id": "vikend-u-samoboru.p3.s4",
          "hr": "„Nisam mogla stati“, rekla je.",
          "nl": "\"Ik kon niet stoppen\", zei ze."
        }
      ]
    },
    {
      "id": "p4",
      "sentences": [
        {
          "id": "vikend-u-samoboru.p4.s1",
          "hr": "Navečer smo se vratile u Zagreb.",
          "nl": "'s Avonds keerden we terug naar Zagreb."
        },
        {
          "id": "vikend-u-samoboru.p4.s2",
          "hr": "Bila sam umorna, ali sretna.",
          "nl": "Ik was moe, maar gelukkig."
        },
        {
          "id": "vikend-u-samoboru.p4.s3",
          "hr": "Sada razumijem zašto ljudi vole male gradove.",
          "nl": "Nu begrijp ik waarom mensen van stadjes houden."
        }
      ]
    }
  ],
