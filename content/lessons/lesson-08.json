  "sections": [
    {
      "id": "s.08.1",
      "title_nl": "In het restaurant",
      "kind": "input",
      "text_hr": "Konobar: Dobar dan! Izvolite?\nGost: Molim jelovnik.\nKonobar: Izvolite. Što želite piti?\nGost: Ja pijem mineralnu vodu, a moja sestra pije bijelu kavu.\nKonobar: A za jelo?\nGost: Ja jedem juhu i ribu. Sestra jede salatu.\nKonobar: Još nešto?\nGost: Ne, hvala. Molim račun.",
      "translation_nl": "Ober: Goedendag! Zegt u het maar.\nGast: De menukaart, graag.\nOber: Alstublieft. Wat wilt u drinken?\nGast: Ik drink mineraalwater, en mijn zus drinkt koffie met melk.\nOber: En om te eten?\nGast: Ik eet soep en vis. Mijn zus eet salade.\nOber: Nog iets?\nGast: Nee, dank u. De rekening, graag.",
      "source": "udzbenik p.108",
