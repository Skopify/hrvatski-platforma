{
  "id": "lesson-08",
  "number": 8,
  "title_hr": "Dobar tek!",
  "title_nl": "Eet smakelijk!",
  "cefr": "A1.2",
  "source": { "udzbenik_pages": "107-118", "vjezbenica_pages": "41-45" },
  "can_do_nl": [
    "Ik kan eten en drinken bestellen in een café of restaurant.",
    "Ik kan zeggen wat ik eet en drink met jesti en piti.",
    "Ik kan soorten eten en smaken benoemen.",
    "Ik kan over mijn eetgewoonten praten.",
    "Ik kan een menukaart lezen."
  ],

  "grammar": [
    {
      "id": "g.08.jesti",
      "title_nl": "jesti — eten",
      "cefr": "A1.2",
      "explanation_nl": "jesti heeft een andere stam in het presens: jed-. Dus jedem, jedeš, jede, jedemo, jedete, jedu. De uitgangen zijn -em, -eš, -e, -emo, -ete, -u — een derde patroon naast de -ati groep (znam) en de -iti groep die in les 9 komt.",
      "contrast_nl": "Waar het Nederlands 'eten' door alle personen bijna gelijk houdt, wisselt het Kroatisch hier van stam: jesti maar jedem. Dat is dezelfde soort wisseling als bij ići → idem.",
      "paradigm": {
        "caption_nl": "jesti — presens",
        "columns": ["jednina", "množina"],
        "rows": [
          { "label": "1.", "cells": ["jedem", "jedemo"] },
          { "label": "2.", "cells": ["jedeš", "jedete"] },
          { "label": "3.", "cells": ["jede", "jedu"] }
        ]
      },
      "pitfalls_nl": [
        "*jestim of *jesem — de stam is jed-.",
        "3e persoon meervoud is jedu, niet *jedeju.",
        "Wat je eet staat in de accusatief: Jedem juhu."
      ],
      "prerequisites": ["g.05.akuzativ.nezivo"],
      "source": "udzbenik p.108"
    },
    {
      "id": "g.08.piti",
      "title_nl": "piti — drinken",
      "cefr": "A1.2",
      "explanation_nl": "piti krijgt in het presens een j in de stam: pij-. Dus pijem, piješ, pije, pijemo, pijete, piju. Net als bij jesti staat wat je drinkt in de accusatief: Pijem kavu.",
      "contrast_nl": "De j komt uit het niets als je alleen naar de infinitief kijkt. Het helpt om piti en pijem als paar te leren, net zoals je bij zvati se de vorm zovem apart moest onthouden.",
      "paradigm": {
        "caption_nl": "piti — presens",
        "columns": ["jednina", "množina"],
        "rows": [
          { "label": "1.", "cells": ["pijem", "pijemo"] },
          { "label": "2.", "cells": ["piješ", "pijete"] },
          { "label": "3.", "cells": ["pije", "piju"] }
        ]
      },
      "pitfalls_nl": [
        "*pitim of *piem — er hoort een j in: pijem.",
        "3e persoon meervoud is piju.",
        "Pijem kavu, niet *pijem kava — de accusatief blijft verplicht."
      ],
      "prerequisites": ["g.08.jesti"],
      "source": "udzbenik p.108"
    },
    {
      "id": "g.08.akuzativ.objekt",
      "title_nl": "De accusatief als lijdend voorwerp — nu bij eten en drinken",
      "cefr": "A1.2",
      "explanation_nl": "Elk werkwoord dat een lijdend voorwerp neemt, vraagt de accusatief. Bij eten en drinken zie je dat constant: Jedem salatu (salata → salatu). Pijem bijelu kavu. Naručujem juhu i ribu. Dit is geen nieuwe regel, maar de plek waar je hem het vaakst nodig hebt.",
      "contrast_nl": "In het Nederlands verandert er niets aan het woord: 'ik eet salade', 'ik zie salade'. In het Kroatisch verraadt de vorm de rol, ook als de woordvolgorde wisselt: 'Salatu jedem' is nog steeds 'ik eet salade'.",
      "paradigm": {
        "caption_nl": "Nominatief → accusatief bij gerechten",
        "columns": ["nominativ", "akuzativ", "geslacht"],
        "rows": [
          { "label": "1.", "cells": ["juha", "juhu", "ženski"] },
          { "label": "2.", "cells": ["salata", "salatu", "ženski"] },
          { "label": "3.", "cells": ["riba", "ribu", "ženski"] },
          { "label": "4.", "cells": ["kruh", "kruh", "muški, neživo"] },
          { "label": "5.", "cells": ["sok", "sok", "muški, neživo"] },
          { "label": "6.", "cells": ["meso", "meso", "srednji"] }
        ]
      },
      "pitfalls_nl": [
        "Bij vrouwelijke woorden de -u vergeten: 'Jedem salata' is fout.",
        "Bij mannelijke en onzijdige woorden juist iets veranderen — daar gebeurt niets.",
        "Meervoud: Jedem sendviče (accusatief meervoud op -e), niet sendviči."
      ],
      "prerequisites": ["g.05.akuzativ.nezivo", "g.05.akuzativ.mnozina"],
      "source": "udzbenik p.109"
    }
  ],

