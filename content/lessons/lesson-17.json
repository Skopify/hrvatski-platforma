  "grammar": [
    {
      "id": "g.17.brojevi_padez",
      "title_nl": "Welke naamval na welk getal?",
      "cefr": "A2.2",
      "explanation_nl": "Dit is de regel die je het vaakst nodig hebt bij winkelen en tijd. Na 1 volgt de nominatief enkelvoud. Na 2, 3 en 4 volgt de genitief enkelvoud. Na 5 en hoger volgt de genitief meervoud. Beslissend is het laatste cijfer: 21 gedraagt zich als 1, 22 als 2, 25 als 5.",
      "contrast_nl": "Het Nederlands kent alleen enkelvoud na 1 en meervoud daarna. Het Kroatisch heeft drie zones, en de tussenzone (2-4) is de val: dva stola, niet dva stolovi.",
      "paradigm": {
        "caption_nl": "Drie zones",
        "columns": ["getal", "naamval", "voorbeeld"],
        "rows": [
          { "label": "1, 21, 101", "cells": ["nominativ jednine", "jedan stol, dvadeset jedan stol"] },
          { "label": "2, 3, 4", "cells": ["genitiv jednine", "dva stola, tri kave, četiri sata"] },
          { "label": "5 – 20", "cells": ["genitiv množine", "pet stolova, deset kava"] },
          { "label": "22, 23, 24", "cells": ["genitiv jednine", "dvadeset dva stola"] },
          { "label": "25 en hoger", "cells": ["genitiv množine", "dvadeset pet stolova"] },
          { "label": "11 – 14", "cells": ["genitiv množine", "jedanaest stolova (uitzondering)"] }
        ]
      },
      "pitfalls_nl": [
        "11 tot en met 14 volgen de 5+ regel, ook al eindigen ze op 1 tot 4.",
        "Het getal 2 heeft een vrouwelijke vorm: dva stola maar dvije kave.",
        "Na 2, 3 en 4 lijkt de vorm op een meervoud maar het is een genitief enkelvoud."
      ],
      "prerequisites": ["g.16.genitiv_mnozina"],
      "source": "udzbenik p.236"
    },
    {
      "id": "g.17.dva_dvije",
      "title_nl": "dva of dvije — het getal buigt mee",
      "cefr": "A2.2",
      "explanation_nl": "De getallen 1 en 2 hebben aparte vormen per geslacht. jedan / jedna / jedno, en dva (mannelijk en onzijdig) tegenover dvije (vrouwelijk). Vanaf 3 verandert het getal niet meer: tri, četiri, pet zijn voor alles gelijk.",
      "contrast_nl": "Het Nederlands zegt altijd 'twee'. Hier moet je bij twee dus nog even nadenken over het geslacht — maar alleen bij 1 en 2, daarna niet meer.",
      "paradigm": {
        "caption_nl": "1 en 2 per geslacht",
        "columns": ["getal", "muški / srednji", "ženski"],
        "rows": [
          { "label": "1", "cells": ["jedan stol / jedno pismo", "jedna kava"] },
          { "label": "2", "cells": ["dva stola / dva pisma", "dvije kave"] },
          { "label": "3", "cells": ["tri stola", "tri kave"] },
          { "label": "4", "cells": ["četiri stola", "četiri kave"] },
          { "label": "5", "cells": ["pet stolova", "pet kava"] }
        ]
      },
      "pitfalls_nl": [
        "*dva kave — bij vrouwelijke woorden is het dvije kave.",
        "Bij onzijdige woorden gebruik je dva, niet dvije: dva pisma.",
        "Voor mannelijke personen bestaat nog een aparte vorm (dvojica), die hier buiten beschouwing blijft."
      ],
      "prerequisites": ["g.17.brojevi_padez"],
      "source": "udzbenik p.236"
    },
    {
      "id": "g.17.redni_brojevi",
      "title_nl": "Rangtelwoorden",
      "cefr": "A2.2",
      "explanation_nl": "Rangtelwoorden zijn bijvoeglijke naamwoorden en buigen dus mee: prvi, druga, treće. Ze worden geschreven met een punt achter het cijfer: 1. dan = prvi dan. De reeks: prvi, drugi, treći, četvrti, peti, šesti, sedmi, osmi, deveti, deseti.",
      "contrast_nl": "Ook het Nederlands maakt er bijvoeglijke naamwoorden van ('de eerste dag'). Het verschil is dat het Kroatisch ze volledig verbuigt, inclusief naamval: u prvom mjesecu.",
      "paradigm": {
        "caption_nl": "Redni brojevi",
        "columns": ["cijfer", "muški", "ženski", "srednji"],
        "rows": [
          { "label": "1.", "cells": ["prvi", "prva", "prvo"] },
          { "label": "2.", "cells": ["drugi", "druga", "drugo"] },
          { "label": "3.", "cells": ["treći", "treća", "treće"] },
          { "label": "4.", "cells": ["četvrti", "četvrta", "četvrto"] },
          { "label": "5.", "cells": ["peti", "peta", "peto"] },
          { "label": "10.", "cells": ["deseti", "deseta", "deseto"] }
        ]
      },
      "pitfalls_nl": [
        "De punt achter het cijfer hoort erbij: 1. dan, niet 1 dan.",
        "treći heeft een ć, geen č.",
        "Na een rangtelwoord volgt gewoon de nominatief, geen genitief: prvi dan."
      ],
      "prerequisites": ["g.04.pridjevi"],
      "source": "udzbenik p.238"
    },
    {
      "id": "g.17.sati_datum",
      "title_nl": "Kloktijd en datum",
      "cefr": "A2.2",
      "explanation_nl": "Kloktijd vraag je met Koliko je sati? Het antwoord volgt de getalregel: jedan sat, dva sata, pet sati. 'Om' is u: u pet sati. Een datum bestaat uit een rangtelwoord plus de maand in de genitief: petog svibnja.",
      "contrast_nl": "sat betekent zowel 'uur' als 'horloge'. En let op dat de getalregel ook hier geldt: 'vier uur' is četiri sata (genitief enkelvoud), maar 'vijf uur' is pet sati (genitief meervoud).",
      "paradigm": {
        "caption_nl": "Tijd en datum",
        "columns": ["vraag of vorm", "voorbeeld"],
        "rows": [
          { "label": "Koliko je sati?", "cells": ["Dva sata. / Pet sati."] },
          { "label": "U koliko sati?", "cells": ["U pet sati."] },
          { "label": "Koji je danas datum?", "cells": ["Petnaesti svibnja."] },
          { "label": "geschreven", "cells": ["15. 5. 2026."] },
          { "label": "duur", "cells": ["Učim hrvatski dva mjeseca."] }
        ]
      },
      "pitfalls_nl": [
        "*pet sata — vanaf 5 is het genitief meervoud: pet sati.",
        "De maand staat in de genitief: svibnja, niet svibanj.",
        "Bij een datum krijgt ook het rangtelwoord de genitief: petnaestog svibnja."
      ],
      "prerequisites": ["g.17.brojevi_padez", "g.17.redni_brojevi"],
      "source": "udzbenik p.240"
    }
  ],

