      "source": "udzbenik p.27",
      "exercises": [
        {
          "id": "e.01.020",
          "type": "teaching_moment",
          "mode": "receptive",
          "prompt_nl": "Leer een woord nooit kaal",
          "body_nl": "Het geslacht bepaalt élke latere naamvalsuitgang. Neem je een woord op zonder geslacht, dan moet je het bij de accusatief (les 5) en de locatief (les 10) opnieuw leren. Vuistregel: medeklinker = m, -a = v, -o/-e = o. Uitzonderingen worden apart gemarkeerd — tata is mannelijk.",
          "targets": ["g.noun.gender.nom.sg"],
          "source": "aangevuld"
        },
        {
          "id": "e.01.021",
          "type": "choice",
          "mode": "receptive",
          "prompt_nl": "Welk geslacht heeft 'bilježnica'?",
          "given": "bilježnica",
          "answer": "ženski rod (vrouwelijk)",
          "distractors": ["muški rod (mannelijk)", "srednji rod (onzijdig)"],
          "explain_nl": "Uitgang -a → vrouwelijk.",
          "targets": ["g.noun.gender.nom.sg", "v.01.biljeznica"],
          "difficulty": 1,
          "source": "udzbenik p.27"
        },
        {
          "id": "e.01.022",
          "type": "cloze",
          "mode": "productive",
          "prompt_nl": "Zet in het meervoud.",
          "given": "To je autobus. To ___ ___.",
          "answer": "su autobusi",
          "accepts": ["su autobusi"],
          "explain_nl": "Mannelijk meervoud op -i; het werkwoord wordt su, maar 'to' verandert niet.",
