  "sections": [
    {
      "id": "s.01.1",
      "title_nl": "Kennismaken",
      "kind": "input",
      "text_hr": "Mariano: Hej, Margareta! Bok! Kako si?\nMargareta: Bok, Mariano. Hvala, izvrsna sam. A kako si ti?\nMariano: Ja sam dobro. Što je novo?\nMargareta: Ništa novo.",
      "translation_nl": "Mariano: Hé, Margareta! Hoi! Hoe gaat het?\nMargareta: Hoi, Mariano. Dank je, uitstekend. En hoe gaat het met jou?\nMariano: Met mij gaat het goed. Wat is er nieuw?\nMargareta: Niets nieuws.",
      "source": "udzbenik p.20",
      "exercises": [
        {
          "id": "e.01.001",
          "type": "teaching_moment",
          "mode": "receptive",
          "prompt_nl": "Merk op",
          "body_nl": "Margareta zegt **izvrsna** sam, niet *izvrsno*. Het bijvoeglijk naamwoord past zich aan haar geslacht aan. Een man zou zeggen: izvrstan sam. Deze congruentie loopt door het hele Kroatisch heen — hou hem vanaf nu in de gaten.",
          "targets": ["g.biti.present.short"],
          "source": "aangevuld"
        },
        {
          "id": "e.01.002",
          "type": "match",
          "mode": "receptive",
          "prompt_nl": "Koppel de begroeting aan de betekenis.",
          "pairs": [
            { "hr": "Bok!", "nl": "Hoi! / Doei!" },
            { "hr": "Dobar dan!", "nl": "Goedendag!" },
            { "hr": "Doviđenja!", "nl": "Tot ziens!" },
            { "hr": "Drago mi je.", "nl": "Aangenaam." }
          ],
          "targets": ["v.01.bok", "v.01.dobar_dan", "v.01.dovidenja", "v.01.drago_mi_je"],
          "difficulty": 1,
          "source": "udzbenik p.20"
        },
        {
          "id": "e.01.003",
          "type": "choice",
          "mode": "receptive",
          "prompt_nl": "Je komt om negen uur 's ochtends je buurvrouw tegen. Wat zeg je?",
          "given": "___, gospođo Perković!",
          "answer": "Dobro jutro",
          "distractors": ["Dobra večer", "Laku noć", "Dobar tek"],
          "explain_nl": "Dobro jutro gebruik je tot ongeveer 10 uur; daarna Dobar dan.",
          "targets": ["v.01.dobro_jutro"],
          "difficulty": 1,
          "audio": "Dobro jutro, gospođo Perković!",
          "source": "udzbenik p.21"
        }
      ]
    },
    {
      "id": "s.01.2",
      "title_nl": "Het werkwoord biti",
      "kind": "grammar",
      "source": "udzbenik p.22-26",
      "exercises": [
        {
          "id": "e.01.010",
          "type": "teaching_moment",
          "mode": "receptive",
          "prompt_nl": "Drie vormen van één werkwoord",
          "body_nl": "biti heeft drie presensvormen naast elkaar. **Kort** (sam) is de standaard in gewone zinnen en kan nooit vooraan staan. **Lang** (jesam) gebruik je in ja/nee-vragen met li en in korte antwoorden. **Ontkennend** (nisam) is één woord — je zet nooit ne los ervoor.\n\nJa sam student. → Jesi li ti student? → Da, jesam. / Ne, nisam.",
          "targets": ["g.biti.present.short", "g.biti.present.long", "g.biti.present.negative"],
          "source": "aangevuld"
        },
        {
          "id": "e.01.011",
          "type": "cloze",
          "mode": "productive",
          "prompt_nl": "Vul de korte vorm van biti in.",
          "given": "Ana ___ studentica.",
          "answer": "je",
          "accepts": ["je"],
          "explain_nl": "Derde persoon enkelvoud, onbeklemtoond.",
          "targets": ["g.biti.present.short"],
          "difficulty": 1,
          "audio": "Ana je studentica.",
          "source": "vježbenica p.12"
        },
        {
          "id": "e.01.012",
          "type": "cloze",
          "mode": "productive",
          "prompt_nl": "Vul de korte vorm van biti in.",
          "given": "Mi ___ Vaši studenti.",
          "answer": "smo",
          "accepts": ["smo"],
          "targets": ["g.biti.present.short"],
          "difficulty": 1,
          "audio": "Mi smo Vaši studenti.",
          "source": "vježbenica p.11"
        },
        {
          "id": "e.01.013",
          "type": "cloze",
          "mode": "productive",
          "prompt_nl": "Vul de ontkennende vorm van biti in.",
          "given": "Marija ___ lektorica.",
          "answer": "nije",
          "accepts": ["nije"],
          "explain_nl": "ne + je wordt nije — één woord.",
          "targets": ["g.biti.present.negative"],
          "difficulty": 2,
          "audio": "Marija nije lektorica.",
          "source": "vježbenica p.13"
        },
        {
          "id": "e.01.014",
          "type": "error_correction",
          "mode": "productive",
          "prompt_nl": "Er zit één fout in deze zin. Verbeter hem.",
          "given": "Ja ne sam profesor.",
          "answer": "Ja nisam profesor.",
          "accepts": ["Ja nisam profesor.", "Nisam profesor.", "Ja nisam profesor"],
          "explain_nl": "biti ontkent met één samengetrokken woord: nisam. Alleen bij andere werkwoorden staat ne los.",
          "targets": ["g.biti.present.negative"],
          "difficulty": 3,
          "source": "aangevuld"
        },
        {
          "id": "e.01.015",
          "type": "error_correction",
          "mode": "productive",
          "prompt_nl": "Er zit één fout in deze zin. Verbeter hem.",
          "given": "Sam student.",
          "answer": "Ja sam student.",
          "accepts": ["Ja sam student.", "Student sam.", "Ja sam student", "Student sam"],
          "explain_nl": "De korte vorm sam is onbeklemtoond en kan niet als eerste woord staan. Zet er het voornaamwoord of het naamwoord vóór.",
          "targets": ["g.biti.present.short"],
          "difficulty": 3,
          "source": "aangevuld"
        },
        {
          "id": "e.01.016",
          "type": "word_order",
          "mode": "productive",
          "prompt_nl": "Zet de woorden in de juiste volgorde tot een vraag.",
          "tokens": ["Jesi", "li", "ti", "studentica"],
          "answer": "Jesi li ti studentica?",
          "accepts": ["Jesi li ti studentica?", "Jesi li ti studentica"],
          "explain_nl": "In een ja/nee-vraag staat de lange vorm voorop, direct gevolgd door li.",
          "targets": ["g.biti.present.long"],
          "difficulty": 2,
          "audio": "Jesi li ti studentica?",
          "source": "udzbenik p.23"
        },
        {
          "id": "e.01.017",
          "type": "cloze",
          "mode": "productive",
          "prompt_nl": "Antwoord bevestigend in de korte vorm.",
          "given": "A: Jesi li ti Hrvat?  B: Da, ___.",
          "answer": "jesam",
          "accepts": ["jesam"],
          "explain_nl": "Een kort antwoord vraagt om de lange, beklemtoonde vorm. 'Da, sam' bestaat niet.",
          "targets": ["g.biti.present.long"],
          "difficulty": 3,
          "audio": "Jesi li ti Hrvat? Da, jesam.",
          "source": "udzbenik p.24"
        },
        {
          "id": "e.01.018",
          "type": "translate_nl_hr",
          "mode": "productive",
          "prompt_nl": "Vertaal naar het Kroatisch.",
          "given": "Zij (meervoud, alleen vrouwen) zijn geen studentes.",
          "answer": "One nisu studentice.",
          "accepts": ["One nisu studentice.", "One nisu studentice"],
          "explain_nl": "one = uitsluitend vrouwelijke groep; nisu = ontkennend meervoud; studentice = nominatief meervoud.",
          "targets": ["g.pron.personal", "g.biti.present.negative", "v.01.studentica"],
          "difficulty": 4,
          "audio": "One nisu studentice.",
          "source": "udzbenik p.26"
        }
      ]
    },
    {
