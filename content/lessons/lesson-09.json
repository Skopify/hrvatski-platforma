  "grammar": [
    {
      "id": "g.09.prezent.iti",
      "code": "PRES-CLASSES",
      "title_nl": "Tegenwoordige tijd van werkwoorden op -iti",
      "cefr": "A1.2",
      "explanation_nl": "De tweede grote werkwoordsgroep. Haal -iti van de infinitief en plak erachter: -im, -iš, -i, -imo, -ite, -e. raditi → radim, radiš, radi, radimo, radite, rade. Zo gaan ook nositi, govoriti, učiti, kupiti, misliti.",
      "contrast_nl": "Voor het Nederlands is er geen verschil tussen deze groepen — 'werken' en 'lezen' vervoegen hetzelfde. In het Kroatisch bepaalt de infinitiefuitgang welke set je krijgt, dus je moet bij elk nieuw werkwoord de klasse meeleren.",
      "paradigm": {
        "caption_nl": "raditi (werken) — presens",
        "columns": ["jednina", "množina"],
        "rows": [
          { "label": "1.", "cells": ["radim", "radimo"] },
          { "label": "2.", "cells": ["radiš", "radite"] },
          { "label": "3.", "cells": ["radi", "rade"] }
        ]
      },
      "pitfalls_nl": [
        "De 3e persoon meervoud is -e, niet -iju: rade, nose, uče.",
        "De 3e persoon enkelvoud heeft geen extra uitgang: radi, niet *radie.",
        "Verwar de klasse niet met de -ati groep: čitati → čitaju, maar raditi → rade."
      ],
      "prerequisites": ["g.05.prezent.ati"],
      "source": "udzbenik p.120"
    },
    {
      "id": "g.09.prezent.jeti",
      "code": "PRES-CLASSES",
      "title_nl": "Werkwoorden op -jeti",
      "cefr": "A1.2",
      "explanation_nl": "Werkwoorden op -jeti vervoegen precies als de -iti groep: vidjeti → vidim, vidiš, vidi, vidimo, vidite, vide. Zo ook živjeti (živim), voljeti (volim), željeti (želim). De je van de infinitief verdwijnt volledig in het presens.",
      "contrast_nl": "Dat de infinitief -jeti heeft maar het presens -im, is precies de reden waarom je een werkwoord altijd met zijn ik-vorm leert. Uit 'voljeti' alleen kun je 'volim' niet afleiden.",
      "paradigm": {
        "caption_nl": "-jeti werkwoorden — de ik-vorm",
        "columns": ["infinitief", "ja-vorm", "betekenis"],
        "rows": [
          { "label": "1.", "cells": ["vidjeti", "vidim", "zien"] },
          { "label": "2.", "cells": ["živjeti", "živim", "wonen, leven"] },
          { "label": "3.", "cells": ["voljeti", "volim", "houden van"] },
          { "label": "4.", "cells": ["željeti", "želim", "wensen, willen"] },
          { "label": "5.", "cells": ["razumjeti", "razumijem", "begrijpen (afwijkend)"] }
        ]
      },
      "pitfalls_nl": [
        "De je meenemen in het presens: *voljem bestaat niet, het is volim.",
        "razumjeti valt buiten het patroon: razumijem, razumiješ, razumije.",
        "voljeti (houden van) en željeti (wensen) lijken op elkaar maar zijn verschillend."
      ],
      "prerequisites": ["g.09.prezent.iti"],
      "source": "udzbenik p.120"
    },
    {
      "id": "g.09.treca_mnozina",
      "code": "PRES-CLASSES",
      "title_nl": "Het verschil dat je moet horen: -e versus -aju",
      "cefr": "A1.2",
      "explanation_nl": "In de derde persoon meervoud lopen de twee grote groepen uiteen. De -ati groep krijgt -aju: čitaju, gledaju, kuhaju. De -iti en -jeti groepen krijgen -e: rade, nose, vide, vole. Dat is vaak het enige verschil tussen 'hij doet' en 'zij doen', dus je moet het horen én produceren.",
      "contrast_nl": "Het Nederlands markeert het meervoud in de derde persoon nauwelijks ('hij werkt' / 'zij werken' verschilt maar één letter). In het Kroatisch is het verschil groter, maar dan wel op een plek waar je het makkelijk verkeerd raadt.",
      "paradigm": {
        "caption_nl": "3. lice množine — twee patronen",
        "columns": ["infinitief", "klasse", "3. l. mn"],
        "rows": [
          { "label": "1.", "cells": ["čitati", "-ati", "čitaju"] },
          { "label": "2.", "cells": ["gledati", "-ati", "gledaju"] },
          { "label": "3.", "cells": ["raditi", "-iti", "rade"] },
          { "label": "4.", "cells": ["nositi", "-iti", "nose"] },
          { "label": "5.", "cells": ["vidjeti", "-jeti", "vide"] },
          { "label": "6.", "cells": ["voljeti", "-jeti", "vole"] }
        ]
      },
      "pitfalls_nl": [
        "*radiju of *nosiju — die vormen bestaan niet.",
        "*čitae of *gledae — de -ati groep houdt de a: čitaju.",
        "Bij twijfel: kijk naar de infinitief, niet naar de betekenis."
      ],
      "prerequisites": ["g.09.prezent.iti", "g.05.prezent.ati"],
      "source": "udzbenik p.121"
    }
  ],

